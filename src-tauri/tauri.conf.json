{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "expodesartistes",
  "version": "0.2.2",
  "identifier": "com.maximilienwithof.expodesartistes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "expodesartistes",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "maximized": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI3MkZCMjk2QUU0NjYzNDMKUldSRFkwYXVsckl2SjRpaGNod2JIVUIzOHdtSnNNVUJ1WDRLbE9vU0F1LysrZVVDODVJczhTZm4K",
      "endpoints": [
        "https://github.com/Maxouillew/expodesartistes/releases/latest/download/latest.json"
      ]
    }
  }
}
